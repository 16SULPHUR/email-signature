{
  "name": "email-signature",
  "version": "1.0.0",
  "description": "Email signature creator",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "templates": "node scripts/build-templates.mjs",
    "predev": "node scripts/build-templates.mjs",
    "prebuild": "node scripts/build-templates.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neon/auth": "0.8.2",
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/email-resend": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "@resvg/resvg-js": "2.6.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "gifenc": "1.0.3",
    "graphql": "^16.8.1",
    "mustache": "4.2.0",
    "next": "16.4.6",
    "payload": "3.94.1",
    "pg": "8.20.0",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4",
    "simple-icons": "16.38.1"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "22.19.9",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
